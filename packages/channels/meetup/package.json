{
  "name": "@postomat/channel-meetup",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@postomat/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "channel-meetup",
    "targets": {
      "contract": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run tests/contract.spec.ts",
          "cwd": "packages/channels/meetup",
          "env": {
            "CONTRACT_TARGET": "local"
          }
        }
      }
    }
  },
  "dependencies": {
    "@postomat/core": "workspace:*",
    "@postomat/templates": "workspace:*",
    "ical.js": "2.2.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@postomat/testing": "workspace:*"
  }
}
