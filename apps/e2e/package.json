{
  "name": "@postomat/e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "e2e",
    "targets": {
      "stack-smoke": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --conditions=@postomat/source --env-file-if-exists=.env apps/e2e/src/stack-smoke.ts --approve",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@postomat/ai": "workspace:*",
    "@postomat/channel-mediawiki": "workspace:*",
    "@postomat/channel-meetup": "workspace:*",
    "@postomat/channel-wordpress": "workspace:*",
    "@postomat/core": "workspace:*",
    "@postomat/db": "workspace:*",
    "@postomat/media": "workspace:*",
    "@postomat/render": "workspace:*",
    "@postomat/templates": "workspace:*",
    "@postomat/testing": "workspace:*",
    "@postomat/workflow": "workspace:*"
  },
  "devDependencies": {
    "ai": "^7.0.179",
    "matrix-bot-sdk": "^0.8.0",
    "sharp": "^0.35.5"
  }
}
