{
  "name": "@postomat/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "bot",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/bot/dist/package.json",
          "{workspaceRoot}/apps/bot/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/bot/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/bot/dist/patches",
          "{workspaceRoot}/apps/bot/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/bot/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "node --conditions=@postomat/source --env-file-if-exists=.env apps/bot/src/main.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "start": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node --env-file-if-exists=.env apps/bot/dist/main.js",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@postomat/core": "workspace:*",
    "@postomat/db": "workspace:*",
    "@postomat/workflow": "workspace:*",
    "matrix-bot-sdk": "^0.8.0"
  }
}
