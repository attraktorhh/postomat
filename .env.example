# Postomat configuration. Copy to .env for local development:  cp .env.example .env
# Every default below points at the local docker compose stack (see dev/README.md).
# NEVER put production credentials into a committed file.

# --- General -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Postgres (docker compose service "postgres", host port 55432)
DATABASE_URL=postgres://postomat:postomat@localhost:55432/postomat
# Used by DB tests and the e2e suite
DATABASE_URL_TEST=postgres://postomat:postomat@localhost:55432/postomat_test
# Public URL of apps/web (links in Matrix messages)
PUBLIC_WEB_URL=http://localhost:3000
# Channel modes, address, hashtags … (defaults are built in; see postomat.config.json)
POSTOMAT_CONFIG=./postomat.config.json

# --- Matrix (apps/bot) ---------------------------------------------------------
MATRIX_HOMESERVER_URL=http://localhost:8008
# Either an access token (production: Synapse is SSO-only) …
MATRIX_ACCESS_TOKEN=
# … or password login (dev only). The device ID must stay stable: it owns the E2EE keys.
MATRIX_USERNAME=postomat
MATRIX_PASSWORD=postomat-bot-dev
MATRIX_DEVICE_ID=POSTOMATDEV
# Crypto store + sync token. Must be a persistent volume in production – never lose it.
MATRIX_DATA_DIR=./.data/matrix
# Seed values for the room picker (quote them: # starts a comment) (/admin/raeume). Used only while the DB has no setting.
MATRIX_MEMBER_ROOMS="#mitglieder:localhost"
MATRIX_MEDIENTEAM_ROOM="#medienteam:localhost"
# Membership cache in seconds (max. 300)
MATRIX_MEMBERSHIP_CACHE_SEC=300

# --- Keycloak OIDC (apps/web) --------------------------------------------------
OIDC_ISSUER=http://localhost:8180/realms/attraktor
OIDC_CLIENT_ID=postomat
OIDC_CLIENT_SECRET=postomat-dev-secret
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
GROUP_MITGLIEDER=mitglieder
GROUP_MEDIENTEAM=medienteam
GROUP_ADMIN=postomat-admin
# Signs the session cookie. Use a long random value in production.
SESSION_SECRET=dev-only-session-secret-change-me
PORT=3000

# --- AI (optional) -------------------------------------------------------------
# none | openai-compatible. Only the post text and facts are sent, never Matrix IDs or names.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000

# --- WordPress (auto channel) ----------------------------------------------------
# Missing username/password → the channel falls back to copy mode.
WORDPRESS_URL=http://localhost:8081
WORDPRESS_USERNAME=postomat
WORDPRESS_APP_PASSWORD=dev0 dev0 dev0 dev0 dev0 dev0
# publish | draft
WORDPRESS_POST_STATUS=publish

# --- MediaWiki (auto channel) ----------------------------------------------------
MEDIAWIKI_API_URL=http://localhost:8082/api.php
MEDIAWIKI_PAGE_BASE_URL=http://localhost:8082/index.php/
MEDIAWIKI_BOT_USERNAME=Postomat@postomat
MEDIAWIKI_BOT_PASSWORD=postomatdevbotpassword0123456789

# --- Nextcloud (photo storage) ---------------------------------------------------
NEXTCLOUD_WEBDAV_URL=http://localhost:8083/remote.php/dav/files/postomat
NEXTCLOUD_USERNAME=postomat
NEXTCLOUD_PASSWORD=postomat-nextcloud-dev
NEXTCLOUD_BASE_FOLDER=/Postomat-Fotos
# Fallback folder when NEXTCLOUD_USERNAME/PASSWORD are empty (dev only)
MEDIA_LOCAL_DIR=./.data/media

# --- Meetup ----------------------------------------------------------------------
# Local fake feed. The real public feed is https://www.meetup.com/attraktor/events/ical/ (read-only).
MEETUP_ICAL_URL=http://localhost:8084/attraktor/events/ical/
# "Meetup öffnen" link in the copy helper (real: https://www.meetup.com/attraktor/)
MEETUP_GROUP_URL=http://localhost:8084/attraktor/
MEETUP_POLL_INTERVAL_MIN=10

# --- Banner / jobs / ports -------------------------------------------------------
DEFAULT_EVENT_DURATION_MIN=180
# Replace the placeholder logo / title font once the real files exist
BANNER_LOGO_PATH=
BANNER_TITLE_FONT_PATH=
JOB_RETRY_LIMIT=3
BOT_HEALTH_PORT=3001
WORKER_HEALTH_PORT=3002
